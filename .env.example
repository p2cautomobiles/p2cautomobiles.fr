# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais versionner .env.local.

# Adresse publique du site (sitemap, liens canoniques, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mettre "true" uniquement en production pour autoriser l'indexation par Google.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Source des véhicules : "demo" (exemples) ou "evialog" (non disponible tant que la méthode d'export n'est pas connue).
VEHICLE_PROVIDER=demo

# Envoi des formulaires au garage.
#   resend : envoi réel (production). Créer un compte sur resend.com et vérifier le domaine d'envoi.
#   file   : développement uniquement, écrit chaque demande dans le dossier .leads/ au lieu de l'envoyer.
#   vide   : envoi désactivé ; les formulaires disent clairement au visiteur que rien n'a été transmis.
LEADS_TRANSPORT=
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend, par exemple "Site P2C <site@votre-domaine.fr>".
LEADS_FROM_EMAIL=
# Adresse(s) qui reçoivent les demandes, séparées par des virgules.
LEADS_TO_EMAIL=

# Evialog : à remplir quand l'éditeur aura fourni son flux ou son API. Côté serveur uniquement.
EVIALOG_FEED_URL=
EVIALOG_API_KEY=
